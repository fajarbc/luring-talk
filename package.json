{
  "name": "luring-talk-call",
  "version": "1.0.0",
  "description": "Luring Talk is a P2P offline video call PWA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:gh-pages": "vite build && node fix-paths.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx components src types.ts utils vite.config.ts",
    "format": "prettier --write .",
    "cert": "node scripts/gen-cert.mjs",
    "start": "node server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "jsqr": "^1.4.0",
    "lz-string": "^1.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.1.4",
    "vitest": "^2.1.9"
  }
}
