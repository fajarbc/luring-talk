{
  "name": "luring-talk-call",
  "version": "1.0.0",
  "description": "Luring Talk is a P2P offline video call PWA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-pwa-icons.mjs && node scripts/verify-pwa-icons.mjs",
    "build": "vite build",
    "prebuild:gh-pages": "node scripts/generate-pwa-icons.mjs && node scripts/verify-pwa-icons.mjs",
    "build:gh-pages": "vite build --mode gh-pages",
    "verify:offline-tailwind": "node scripts/verify-offline-tailwind.mjs",
    "verify:pwa-icons": "node scripts/verify-pwa-icons.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx components src types.ts utils vite.config.ts",
    "format": "prettier --write .",
    "cert": "node scripts/gen-cert.mjs",
    "start": "node server.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "express": "^4.18.2",
    "jsqr": "^1.4.0",
    "lz-string": "^1.5.0",
    "material-symbols": "^0.47.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.1.13",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "vitest": "^2.1.9"
  }
}
